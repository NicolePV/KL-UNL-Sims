function changeShowAccelerationArrow()
{
   this._parent.visualizationMC.setShowAccelerationArrow(showAccelerationArrowCheck.getValue());
}
function changeShowVelocityArrow()
{
   this._parent.visualizationMC.setShowVelocityArrow(showVelocityArrowCheck.getValue());
}
function changeShowVelocityTangent()
{
   this._parent.visualizationMC.setShowVelocityTangent(showVelocityTangentCheck.getValue());
}
function changeShowAccelerationLine()
{
   this._parent.visualizationMC.setShowAccelerationLine(showAccelerationLineCheck.getValue());
}
